# AI Jyotish - Environment Configuration Example
# Copy this file to .env and configure your secrets.
# NEVER commit .env to GitHub or source control.

PORT=3000

# Server-Side Google AI Studio Gemini API Key
# Obtain your free API key at: https://aistudio.google.com/
# If omitted or left empty, the application operates in Mock Mode with zero budget.
GEMINI_API_KEY=your_api_key_here
